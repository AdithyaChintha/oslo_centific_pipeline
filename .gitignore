ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================================
# OUTPUT FILES - KEEP ANALYSIS RESULTS BUT EXCLUDE LARGE FILES
# ============================================================================

# Keep JSON results and summary reports
!output/**/*.json
!output/**/*.txt

# But exclude large video files in output
output/**/*.mp4
output/**/*.avi
output/**/*.mov
output/**/*.mkv
output/**/*.insv

# Exclude temporary processing files
output/**/temp_*
output/**/tmp_*
output/**/*.tmp

